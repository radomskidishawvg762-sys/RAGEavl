# ============================================================
# RAGEval Studio 环境变量模板（仅占位符，禁止写入真实凭据）
#
# 使用方式：cp .env.example .env.local 后填入真实值
# .env.local / .env.test 不提交 Git
# ============================================================

# ---------- 数据库（Supabase Cloud 托管 PostgreSQL） ----------
# 应用运行连接（SQLAlchemy Engine）
# 格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# 必填。不使用 localhost:5432 作为生产默认值。
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

# Alembic 迁移连接（可选）
# 留空时自动回退到 DATABASE_URL
ALEMBIC_DATABASE_URL=

# 测试连接（可选）
# 专用测试数据库（推荐独立的 Supabase Test Project），必须 ≠ DATABASE_URL
# 行为约定（tests/conftest.py 强制）：
#   - 未配置           -> PostgreSQL 集成测试显式 skip（不计入 passed）
#   - == DATABASE_URL  -> pytest 启动即报错退出（测试永不写生产库）
#   - 已配置           -> 首次运行自动执行 alembic upgrade head（Alembic 是唯一迁移体系）
TEST_DATABASE_URL=

# ---------- 环境 ----------
# dev / test / demo
RAGEVAL_ENV=dev

# ---------- Judge LLM（LLM-as-a-Judge 判分） ----------
# MVP 固定单一 Judge Model（PRD Q2），多 Judge 为 P1
# 以下为占位符，真实值同样只写入 .env.local，不入 Git
JUDGE_PROVIDER=<provider>
JUDGE_MODEL=<model>
JUDGE_MODEL_VERSION=<model_version>
JUDGE_API_KEY=<api_key>

# ---------- RAG 输入 Adapter（T-14B 正式输入边界）----------
# 留空 -> 仅走 GoldenRunMetadataAdapter（测试/金标回放兼容）
# 填写 -> HttpRagAdapter：POST <url> {"question": "..."} -> {"answer": "...", "contexts": [...]}
#
# 注意：这三个变量直接在这里（.env.local）生效，不需要 export 到 shell —— 2026-09-28
# 之前它们只被 config/system.yaml 的 ${VAR} 读取，而那个替换只认 os.environ，所以只写在
# .env.local 里的值会被静默忽略、所有 run 悄悄退回金标回放（答案是数据集自带的）。现在
# 由 Settings 承接（system 层留空时才补，profile 层显式配置永不被覆盖）。
# 因此：**一旦在这里填了 URL，本机所有 run 都会改走 HTTP**，失败会以记录级
# EXT_RAG_ADAPTER_* 错误出现。只想跑金标就不要填。
RAG_INPUT_URL=
RAG_INPUT_TIMEOUT=30
RAG_INPUT_RETRY=2

# ---------- 运行时（可选，有默认值） ----------
# Judge 调用并发度（asyncio.Semaphore）
RAGEVAL_JUDGE_CONCURRENCY=8
# 数据库连接池
RAGEVAL_DB_POOL_SIZE=5
RAGEVAL_DB_MAX_OVERFLOW=5
