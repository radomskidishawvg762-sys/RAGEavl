# ============ 密钥与环境配置（严禁提交） ============
# Supabase Cloud 迁移后，DATABASE_URL 含数据库凭据，等同 Secret
.env
.env.local
.env.test
.env.demo
.env.*.local
!.env.example

# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.xml
htmlcov/
.coverage

# ============ Node / 前端 ============
node_modules/
dist/
build/
*.tsbuildinfo

# ============ 数据与导出（MVP 本地挂载，含业务数据） ============
exports/
*.dump
*.sql.gz

# ============ Supabase CLI 本地状态（非项目配置，不入库） ============
# .temp/     : CLI 版本缓存（cli-latest，每次升级都变）+ start-secrets
# .branches/ : CLI 分支指针
# 说明：带中间斜杠的模式锚定到仓库根，`supabase/.temp/` 无法覆盖嵌套层级
# （supabase/supabase/.temp/），故用 `**` 一次覆盖所有层级。
# 注意：config.toml 属项目配置，不在此列，仍受版本控制。
supabase/**/.temp/
supabase/**/.branches/

# ============ 本地模型权重（不提交到 Git） ============
# 注意：必须带前导斜杠锚定到仓库根。裸写 `models/` 会匹配**任意层级**的同名目录，
# 会把 app/models/（全部 10 张表的 SQLAlchemy ORM 定义）一并排除在版本控制之外。
/models/

# ============ IDE / 系统 ============
.idea/
.vscode/
.DS_Store
Thumbs.db

# ============ 日志 ============
*.log
logs/

# ============ e2e 残留输出（scripts/run_e2e.py 产物，不入库） ============
.e2e_*

# ============ WorkBuddy 工作记忆（工具元数据，不入库） ============
.workbuddy/
